@model BasicASP.Models.PersonViewModel

<div class="card">
    <div class="card-header">
        <h4>Person Information Form</h4>
    </div>
    <div class="card-body">
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Age" class="form-label"></label>
            <input asp-for="Age" class="form-control" type="number" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>
    </div>
</div>

<!-- General Contract Persons Section -->
<div class="card mt-3 border-secondary">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people"></i> General Contract Persons</h5>
        <button type="button" class="btn btn-light btn-sm" id="addGeneralContractPersonBtn">
            <i class="bi bi-plus-circle"></i> Add Person
        </button>
    </div>
    <div class="card-body">
        <div id="generalContractPersonsList">
            <p class="text-muted" id="noGeneralPersonsMsg">No contract persons added yet.</p>
            <div class="table-responsive d-none" id="generalPersonsTable">
                <table class="table table-hover table-sm">
                    <thead class="table-secondary">
                        <tr>
                            <th>#</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Age</th>
                            <th>Position</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="generalPersonsTableBody"></tbody>
                </table>
            </div>
        </div>
        <div id="generalContractPersonsHiddenInputs"></div>
    </div>
</div>

<!-- General Contract Person Modal -->
<div class="modal fade" id="generalContractPersonModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title" id="generalContractPersonModalLabel">Add General Contract Person</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="generalContractPersonForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name *</label>
                            <input type="text" class="form-control" id="genPersonFirstName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name *</label>
                            <input type="text" class="form-control" id="genPersonLastName" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Age *</label>
                            <input type="number" class="form-control" id="genPersonAge" min="18" max="100" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Position</label>
                            <input type="text" class="form-control" id="genPersonPosition" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="genPersonNotes" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-secondary" id="saveGeneralContractPersonBtn">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        if (window.generalContractPersonsInitialized) return;
        window.generalContractPersonsInitialized = true;

        window.generalContractPersons = window.generalContractPersons || [];
        var editingGeneralPersonIndex = -1;

        // Handle modal hide event to remove focus
        $('#generalContractPersonModal').on('hide.bs.modal', function() {
            $(document.activeElement).blur();
        });

        function renderGeneralContractPersons() {
            if (window.generalContractPersons.length === 0) {
                $('#noGeneralPersonsMsg').removeClass('d-none');
                $('#generalPersonsTable').addClass('d-none');
            } else {
                $('#noGeneralPersonsMsg').addClass('d-none');
                $('#generalPersonsTable').removeClass('d-none');
                
                var tbody = $('#generalPersonsTableBody');
                tbody.empty();
                
                window.generalContractPersons.forEach(function(person, index) {
                    tbody.append(`
                        <tr>
                            <td>${index + 1}</td>
                            <td>${person.FirstName}</td>
                            <td>${person.LastName}</td>
                            <td>${person.Age}</td>
                            <td>${person.Position || '-'}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-warning edit-gen-person" data-index="${index}">Edit</button>
                                <button type="button" class="btn btn-sm btn-danger delete-gen-person" data-index="${index}">Delete</button>
                            </td>
                        </tr>
                    `);
                });
            }
            updateGeneralHiddenInputs();
        }

        function updateGeneralHiddenInputs() {
            var container = $('#generalContractPersonsHiddenInputs');
            container.empty();
            window.generalContractPersons.forEach(function(person, index) {
                container.append(`
                    <input type="hidden" name="ContractPersons[${index}].FirstName" value="${person.FirstName}" />
                    <input type="hidden" name="ContractPersons[${index}].LastName" value="${person.LastName}" />
                    <input type="hidden" name="ContractPersons[${index}].Age" value="${person.Age}" />
                    <input type="hidden" name="ContractPersons[${index}].Position" value="${person.Position || ''}" />
                    <input type="hidden" name="ContractPersons[${index}].Notes" value="${person.Notes || ''}" />
                `);
            });
        }

        $(document).off('click', '#addGeneralContractPersonBtn').on('click', '#addGeneralContractPersonBtn', function() {
            editingGeneralPersonIndex = -1;
            $('#generalContractPersonModalLabel').text('Add General Contract Person');
            $('#genPersonFirstName').val('');
            $('#genPersonLastName').val('');
            $('#genPersonAge').val('');
            $('#genPersonPosition').val('');
            $('#genPersonNotes').val('');
            var modal = new bootstrap.Modal(document.getElementById('generalContractPersonModal'));
            modal.show();
        });

        $(document).off('click', '.edit-gen-person').on('click', '.edit-gen-person', function() {
            editingGeneralPersonIndex = $(this).data('index');
            var person = window.generalContractPersons[editingGeneralPersonIndex];
            $('#generalContractPersonModalLabel').text('Edit General Contract Person');
            $('#genPersonFirstName').val(person.FirstName);
            $('#genPersonLastName').val(person.LastName);
            $('#genPersonAge').val(person.Age);
            $('#genPersonPosition').val(person.Position);
            $('#genPersonNotes').val(person.Notes);
            var modal = new bootstrap.Modal(document.getElementById('generalContractPersonModal'));
            modal.show();
        });

        $(document).off('click', '.delete-gen-person').on('click', '.delete-gen-person', function() {
            if (confirm('Delete this person?')) {
                window.generalContractPersons.splice($(this).data('index'), 1);
                renderGeneralContractPersons();
            }
        });

        $(document).off('click', '#saveGeneralContractPersonBtn').on('click', '#saveGeneralContractPersonBtn', function(e) {
            var person = {
                FirstName: $('#genPersonFirstName').val().trim(),
                LastName: $('#genPersonLastName').val().trim(),
                Age: parseInt($('#genPersonAge').val()),
                Position: $('#genPersonPosition').val().trim(),
                Notes: $('#genPersonNotes').val().trim()
            };

            if (!person.FirstName || !person.LastName || !person.Age) {
                alert('Please fill required fields');
                return;
            }

            if (editingGeneralPersonIndex >= 0) {
                window.generalContractPersons[editingGeneralPersonIndex] = person;
            } else {
                window.generalContractPersons.push(person);
            }

            renderGeneralContractPersons();
            
            // Remove focus from button before closing modal
            $(e.target).blur();
            
            var modalEl = document.getElementById('generalContractPersonModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            } else {
                $('#generalContractPersonModal').modal('hide');
            }
        });
    })();
</script>
