<!-- Contract Person Modal -->
<div class="modal fade" id="contractPersonModal" tabindex="-1" aria-labelledby="contractPersonModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="contractPersonModalLabel">Add Contract Person</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="contractPersonForm">
                    <input type="hidden" id="personIndex" value="-1" />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="personFirstName" class="form-label">First Name *</label>
                                <input type="text" class="form-control" id="personFirstName" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="personLastName" class="form-label">Last Name *</label>
                                <input type="text" class="form-control" id="personLastName" required />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="personAge" class="form-label">Age *</label>
                                <input type="number" class="form-control" id="personAge" min="18" max="100" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="personPosition" class="form-label">Position</label>
                                <input type="text" class="form-control" id="personPosition" placeholder="e.g., Manager, Developer" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="personNotes" class="form-label">Notes</label>
                        <textarea class="form-control" id="personNotes" rows="2" placeholder="Additional information..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveContractPersonBtn">
                    <i class="bi bi-save"></i> Save Person
                </button>
            </div>
        </div>
    </div>
</div>
