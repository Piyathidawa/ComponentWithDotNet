@model BasicASP.Models.PersonViewModel

@{
    ViewData["Title"] = "Create Person";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Select person type to dynamically change the form component</p>

    <form asp-action="Create" method="post" id="personForm">
        <div class="card mb-3">
            <div class="card-body">
                <div class="form-group mb-3">
                    <label asp-for="PersonType" class="form-label">Person Type</label>
                    <select asp-for="PersonType" class="form-select" id="personTypeDropdown">
                        <option value="Student">Student</option>
                        <option value="Employee">Employee</option>
                        <option value="General">General Person</option>
                    </select>
                </div>
            </div>
        </div>

        <div id="dynamicFormContainer">
            @await Component.InvokeAsync("PersonForm", Model)
        </div>
        
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            $('#personTypeDropdown').change(function() {
                var personType = $(this).val();
                var formData = $('#personForm').serialize();
                
                $.ajax({
                    url: '@Url.Action("GetPersonFormComponent", "Person")',
                    type: 'GET',
                    data: { personType: personType },
                    success: function(result) {
                        $('#dynamicFormContainer').html(result);
                        
                        // Reinitialize validation
                        var form = $('#personForm');
                        form.removeData('validator');
                        form.removeData('unobtrusiveValidation');
                        $.validator.unobtrusive.parse(form);
                    },
                    error: function() {
                        alert('Error loading form component');
                    }
                });
            });
        });
    </script>
}
