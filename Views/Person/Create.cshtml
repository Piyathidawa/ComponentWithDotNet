@model BasicASP.Models.PersonViewModel

@{
    ViewData["Title"] = "Create Person";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Select person type to dynamically change the form component</p>

    <form asp-action="Create" method="post" id="personForm">
        <div class="card mb-3">
            <div class="card-body">
                <div class="form-group mb-3">
                    <label asp-for="PersonType" class="form-label">Person Type</label>
                    <select asp-for="PersonType" class="form-select" id="personTypeDropdown">
                        <option value="Student">Student</option>
                        <option value="Employee">Employee</option>
                        <option value="General">General Person</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Dynamic Form Container - Each form has its own contract management -->
        <div id="dynamicFormContainer">
            @await Component.InvokeAsync("PersonForm", Model)
        </div>
        
        <div class="mt-3">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-check-circle"></i> Submit
            </button>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary btn-lg">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            $('select').select2({
                width:'100%'
            });

            // Person Type Dropdown Change
            $('#personTypeDropdown').change(function() {
                var personType = $(this).val();
                console.log('Person Type Changed to:', personType);
                
                $.ajax({
                    url: '@Url.Action("GetPersonFormComponent", "Person")',
                    type: 'GET',
                    data: { personType: personType },
                    success: function(result) {
                        $('#dynamicFormContainer').html(result);
                        console.log('Component loaded for:', personType);
                        
                        var form = $('#personForm');
                        form.removeData('validator');
                        form.removeData('unobtrusiveValidation');
                        $.validator.unobtrusive.parse(form);
                    },
                    error: function() {
                        console.error('Error loading form component');
                        alert('Error loading form component');
                    }
                });
            });

            // Form Submit
            $('#personForm').on('submit', function(e) {
                e.preventDefault();
                
                console.log('=== FORM SUBMIT CLICKED ===');
                var formData = {};
                $('#personForm').serializeArray().forEach(function(field) {
                    formData[field.name] = field.value;
                });
                console.log('Form Data Object:', formData);
                console.log('JSON Format:', JSON.stringify(formData, null, 2));
                console.log('Sending data to C# backend...');
                console.log('===========================');
                
                this.submit();
            });

            console.log('Person Form initialized');
        });
    </script>
}
