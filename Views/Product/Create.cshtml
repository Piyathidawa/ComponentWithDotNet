@model BasicASP.Models.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Example of View Component with dropdown and complex validation</p>

    <form asp-action="Create" method="post">
        @await Component.InvokeAsync("ProductForm", Model)
        
        <div class="mt-3">
            <button type="submit" class="btn btn-success">Create Product</button>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
